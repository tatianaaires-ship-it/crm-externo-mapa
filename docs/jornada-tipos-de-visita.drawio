          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="legenda" value="&lt;b&gt;COMO LER&lt;/b&gt;&lt;br&gt;&lt;br&gt;A &lt;b&gt;banda&lt;/b&gt; é a primeira leitura: aquisição&lt;br&gt;(falta a 1ª compra) × recorrência&lt;br&gt;(o cliente que compra).&lt;br&gt;&lt;br&gt;Toda pergunta tem os ramos nomeados,&lt;br&gt;então &lt;b&gt;todo pin chega a um tipo&lt;/b&gt; — não&lt;br&gt;há saída sem formulário.&lt;br&gt;&lt;br&gt;&lt;b&gt;Borda tracejada âmbar&lt;/b&gt; = também serve&lt;br&gt;de fallback enquanto falta dado.&lt;br&gt;&lt;br&gt;&lt;b&gt;4 meses / 120 dias&lt;/b&gt; aparece 3 vezes:&lt;br&gt;sem compra (a raiz) e sem visita (os&lt;br&gt;dois ramos da aquisição)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#e0e0e0;align=left;verticalAlign=top;spacing=12;fontSize=11;fontColor=#616161" vertex="1" parent="1">
          <mxGeometry x="40" y="680" width="270" height="260" as="geometry" />
        </mxCell>

        <mxCell id="abertos" value="&lt;b&gt;⚠️ O QUE SEGUE ABERTO&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;1. O pico do dia 1º.&lt;/b&gt; &quot;Não comprou no mês corrente&quot; é verdade para a base recorrente inteira na virada do mês — e quem compra a cada 45 dias fica em retenção todo mês sem estar atrasado.&lt;br&gt;&lt;br&gt;&lt;b&gt;2. De quem é a banda de recorrência?&lt;/b&gt; Se for de inside/growth, esses tipos existem no modelo mas não no check-out do campo.&lt;br&gt;&lt;br&gt;&lt;b&gt;3. O que define &quot;oportunidade de aquisição&quot;?&lt;/b&gt; Assumido: sem 1ª compra OU +120 dias sem comprar. Se for régua da operação, deixa de ser derivável." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff8e1;strokeColor=#ffb300;align=left;verticalAlign=top;spacing=12;fontSize=11;fontColor=#e65100" vertex="1" parent="1">
          <mxGeometry x="1400" y="160" width="440" height="330" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>

  <diagram id="cartoes-formularios" name="Objetivo + informações chave">
    <mxGraphModel dx="2000" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2000" pageHeight="800" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="ct" value="O que buscar em cada tipo de visita" style="text;html=1;fontSize=22;fontStyle=1;fontColor=#212121;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="40" y="34" width="700" height="30" as="geometry" />
        </mxCell>
        <mxCell id="ct2" value="Objetivo + 3 informações chave por tipo. A moldura É a regra: o que não cabe em três não entra. Nada aqui repete o tronco comum (TD encontrado · Vendeu? · motivo · notas), que é perguntado nos sete." style="text;html=1;fontSize=12;fontColor=#757575;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="40" y="66" width="1400" height="20" as="geometry" />
        </mxCell>

        <mxCell id="banda1" value="AQUISIÇÃO" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f4f4f4;strokeColor=#e0e0e0;dashed=1;verticalAlign=top;align=left;spacingLeft=14;spacingTop=8;fontColor=#9e9e9e;fontSize=11;fontStyle=1;letterSpacing=1" vertex="1" parent="1">
          <mxGeometry x="40" y="110" width="820" height="420" as="geometry" />
        </mxCell>
        <mxCell id="banda2" value="RECORRÊNCIA" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f4f4f4;strokeColor=#e0e0e0;dashed=1;verticalAlign=top;align=left;spacingLeft=14;spacingTop=8;fontColor=#9e9e9e;fontSize=11;fontStyle=1;letterSpacing=1" vertex="1" parent="1">
          <mxGeometry x="890" y="110" width="1080" height="420" as="geometry" />
        </mxCell>

        <mxCell id="c1" value="&lt;b&gt;🚩 1ª VISITA&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;u&gt;Objetivo:&lt;/u&gt;&lt;br&gt;conhecer o EC e saber se é oportunidade real — é a visita que corrige a base&lt;br&gt;&lt;br&gt;&lt;u&gt;Informações chave:&lt;/u&gt;&lt;br&gt;- perfil real: trabalha food service? tipologia observada&lt;br&gt;- fornecedor atual e frequência&lt;br&gt;- quem decide (cargo) + melhor dia/hora" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;fillColor=#e8eaf6;strokeColor=#5c6bc0;fontColor=#283593;fontSize=11;align=left;verticalAlign=top;spacing=12" vertex="1" parent="1">
          <mxGeometry x="70" y="150" width="240" height="350" as="geometry" />
        </mxCell>
        <mxCell id="c2" value="&lt;b&gt;🔁 FOLLOW-UP&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;u&gt;Objetivo:&lt;/u&gt;&lt;br&gt;destravar o primeiro pedido — o que exatamente falta para o sim&lt;br&gt;&lt;br&gt;&lt;u&gt;Informações chave:&lt;/u&gt;&lt;br&gt;- o que precisa acontecer para fechar (fechado)&lt;br&gt;- prazo esperado da decisão&lt;br&gt;- já recebeu proposta? já testou produto?" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;fillColor=#e8eaf6;strokeColor=#5c6bc0;fontColor=#283593;fontSize=11;align=left;verticalAlign=top;spacing=12" vertex="1" parent="1">
          <mxGeometry x="330" y="150" width="240" height="350" as="geometry" />
        </mxCell>
        <mxCell id="c3" value="&lt;b&gt;♻️ REAQUISIÇÃO&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;u&gt;Objetivo:&lt;/u&gt;&lt;br&gt;entender por que parou e se dá para trazer de volta&lt;br&gt;&lt;br&gt;&lt;u&gt;Informações chave:&lt;/u&gt;&lt;br&gt;- motivo de ter parado (fechado)&lt;br&gt;- de quem compra hoje&lt;br&gt;- o que traria de volta + é recuperável?&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#2e7d32&quot;&gt;⭐ o cartão mais valioso: motivo de churn não existe em lugar nenhum hoje&lt;/font&gt;" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;fillColor=#e8eaf6;strokeColor=#43a047;strokeWidth=2;fontColor=#283593;fontSize=11;align=left;verticalAlign=top;spacing=12" vertex="1" parent="1">
          <mxGeometry x="590" y="150" width="240" height="350" as="geometry" />
        </mxCell>

        <mxCell id="c4" value="&lt;b&gt;🗓️ RECORRÊNCIA&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;u&gt;Objetivo:&lt;/u&gt;&lt;br&gt;fazer sair a 2ª/3ª compra dentro da janela de 45 dias&lt;br&gt;&lt;br&gt;&lt;u&gt;Informações chave:&lt;/u&gt;&lt;br&gt;- sabe como pedir? (canal)&lt;br&gt;- a 1ª compra atendeu? (prazo, produto, qualidade)&lt;br&gt;- o que falta para a próxima compra" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;fillColor=#e8eaf6;strokeColor=#5c6bc0;fontColor=#283593;fontSize=11;align=left;verticalAlign=top;spacing=12" vertex="1" parent="1">
          <mxGeometry x="920" y="150" width="240" height="350" as="geometry" />
        </mxCell>
        <mxCell id="c5" value="&lt;b&gt;🤝 RELACIONAMENTO&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;u&gt;Objetivo:&lt;/u&gt;&lt;br&gt;manter a relação de quem comprou e não engatou — e decidir se segue na carteira&lt;br&gt;&lt;br&gt;&lt;u&gt;Informações chave:&lt;/u&gt;&lt;br&gt;- por que não repetiu&lt;br&gt;- está comprando de outro?&lt;br&gt;- vale seguir? (carteira / inside / descartar)" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;fillColor=#e8eaf6;strokeColor=#5c6bc0;fontColor=#283593;fontSize=11;align=left;verticalAlign=top;spacing=12" vertex="1" parent="1">
          <mxGeometry x="1180" y="150" width="240" height="350" as="geometry" />
        </mxCell>
        <mxCell id="c6" value="&lt;b&gt;📈 EXPANSÃO&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;u&gt;Objetivo:&lt;/u&gt;&lt;br&gt;aumentar receita em quem já compra — mix, volume, categoria&lt;br&gt;&lt;br&gt;&lt;u&gt;Informações chave:&lt;/u&gt;&lt;br&gt;- categorias que compra de outro fornecedor&lt;br&gt;- o que foi ofertado nesta visita&lt;br&gt;- barreira à ampliação (fechado)" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;fillColor=#e8eaf6;strokeColor=#5c6bc0;fontColor=#283593;fontSize=11;align=left;verticalAlign=top;spacing=12" vertex="1" parent="1">
          <mxGeometry x="1440" y="150" width="240" height="350" as="geometry" />
        </mxCell>
        <mxCell id="c7" value="&lt;b&gt;🛡️ RETENÇÃO&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;u&gt;Objetivo:&lt;/u&gt;&lt;br&gt;entender a compra que não veio, antes de virar churn&lt;br&gt;&lt;br&gt;&lt;u&gt;Informações chave:&lt;/u&gt;&lt;br&gt;- por que não comprou este mês (fechado)&lt;br&gt;- vai comprar ainda este mês?&lt;br&gt;- risco de perder (baixo / médio / alto)" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;fillColor=#e8eaf6;strokeColor=#5c6bc0;fontColor=#283593;fontSize=11;align=left;verticalAlign=top;spacing=12" vertex="1" parent="1">
          <mxGeometry x="1700" y="150" width="240" height="350" as="geometry" />
        </mxCell>

        <mxCell id="mostra" value="&lt;b&gt;👁️ O QUE A TELA MOSTRA&lt;/b&gt; — não é campo, e por isso não entra nos três bullets; mas sem isso a pergunta sai no vácuo&lt;br&gt;&lt;br&gt;&lt;b&gt;1ª visita:&lt;/b&gt; endereço e CNPJ, para conferir com o que está na porta&amp;nbsp; ·&amp;nbsp; &lt;b&gt;Follow-up:&lt;/b&gt; &lt;font color=&quot;#e65100&quot;&gt;se há histórico de compra — obrigatório, porque este tipo atende quem nunca comprou E ex-cliente&lt;/font&gt;&amp;nbsp; ·&amp;nbsp; &lt;b&gt;Reaquisição:&lt;/b&gt; data e valor da última compra&lt;br&gt;&lt;b&gt;Recorrência:&lt;/b&gt; 1ª compra + quantos dias restam na janela&amp;nbsp; ·&amp;nbsp; &lt;b&gt;Relacionamento:&lt;/b&gt; quantas compras fez e quando foi a última&amp;nbsp; ·&amp;nbsp; &lt;b&gt;Expansão:&lt;/b&gt; ticket, frequência e as categorias que já compra&amp;nbsp; ·&amp;nbsp; &lt;b&gt;Retenção:&lt;/b&gt; última compra e a média das últimas 3" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#e0e0e0;align=left;verticalAlign=top;spacing=12;fontSize=11;fontColor=#616161" vertex="1" parent="1">
          <mxGeometry x="40" y="560" width="1930" height="120" as="geometry" />
        </mxCell>

        <mxCell id="nota3" value="&lt;b&gt;Só 3 dos 21 campos são opinião do vendedor&lt;/b&gt; — risco de perder, vale seguir? e é recuperável? —, e os três estão nos tipos em que a decisão É de julgamento. O resto é fato observado, que é o que sustenta &quot;perguntar o fato, nunca a categoria&quot;." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f4f4f4;strokeColor=#e0e0e0;align=left;verticalAlign=top;spacing=12;fontSize=11;fontColor=#616161" vertex="1" parent="1">
          <mxGeometry x="40" y="700" width="1930" height="60" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>

  <diagram id="escada-silencio" name="Escada do silêncio">
    <mxGraphModel dx="1600" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="700" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="st" value="A escada do silêncio — banda de recorrência" style="text;html=1;fontSize=22;fontStyle=1;fontColor=#212121;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="60" y="50" width="700" height="30" as="geometry" />
        </mxCell>
        <mxCell id="st2" value="O eixo é quanto tempo sem comprar. A retenção é um degrau ESTREITO — um mês só —, e no fim da escada o ponto troca de banda." style="text;html=1;fontSize=12;fontColor=#757575;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="60" y="80" width="1000" height="20" as="geometry" />
        </mxCell>

        <mxCell id="s1" value="comprou&lt;br&gt;&lt;b&gt;este mês&lt;/b&gt;&lt;br&gt;&lt;br&gt;📈 EXPANSÃO" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8eaf6;strokeColor=#5c6bc0;fontColor=#283593;fontSize=13" vertex="1" parent="1">
          <mxGeometry x="80" y="180" width="230" height="120" as="geometry" />
        </mxCell>
        <mxCell id="s2" value="comprou&lt;br&gt;&lt;b&gt;mês passado&lt;/b&gt;&lt;br&gt;&lt;br&gt;🛡️ RETENÇÃO&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;um mês só&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8eaf6;strokeColor=#5c6bc0;fontColor=#283593;fontSize=13" vertex="1" parent="1">
          <mxGeometry x="390" y="180" width="230" height="120" as="geometry" />
        </mxCell>
        <mxCell id="s3" value="&lt;b&gt;~30 a 120 dias&lt;/b&gt;&lt;br&gt;sem comprar&lt;br&gt;&lt;br&gt;📈 EXPANSÃO&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;volta a ser&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8eaf6;strokeColor=#5c6bc0;fontColor=#283593;fontSize=13" vertex="1" parent="1">
          <mxGeometry x="700" y="180" width="230" height="120" as="geometry" />
        </mxCell>
        <mxCell id="s4" value="&lt;b&gt;mais de 120 dias&lt;/b&gt;&lt;br&gt;sem comprar&lt;br&gt;&lt;br&gt;♻️ REAQUISIÇÃO&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;troca de banda&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8eaf6;strokeColor=#5c6bc0;fontColor=#283593;fontSize=13" vertex="1" parent="1">
          <mxGeometry x="1010" y="180" width="230" height="120" as="geometry" />
        </mxCell>

        <mxCell id="b1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#9e9e9e;endArrow=blockThin;endFill=1" edge="1" parent="1" source="s1" target="s2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="b2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#9e9e9e;endArrow=blockThin;endFill=1" edge="1" parent="1" source="s2" target="s3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="b3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#9e9e9e;endArrow=blockThin;endFill=1" edge="1" parent="1" source="s3" target="s4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="rec" value="&lt;b&gt;Decidido 03/08 — retenção é sinal ESTREITO, não faixa&lt;/b&gt;&lt;br&gt;&lt;br&gt;Só é retenção quem é recorrente &lt;b&gt;e&lt;/b&gt; comprou no mês anterior: é a falha &lt;i&gt;fresca&lt;/i&gt;, a anomalia de um mês. Passado isso o ponto volta a EXPANSÃO, e aos 120 dias sai da banda.&lt;br&gt;&lt;br&gt;⛔ Recusada a alternativa de cobrir a faixa inteira: alargar o sinal o transformaria em &quot;cliente que não comprou&quot; — quase toda a base num mês qualquer — e o formulário de retenção perderia o alvo.&lt;br&gt;&lt;br&gt;⚠️ Preço aceito: o afastamento é tratado em duas janelas (1 mês e 4 meses); no meio delas o app confia no vendedor." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#e0e0e0;align=left;verticalAlign=top;spacing=12;fontSize=11;fontColor=#616161" vertex="1" parent="1">
          <mxGeometry x="390" y="370" width="540" height="220" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
