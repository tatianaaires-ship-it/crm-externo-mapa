        <mxCell id="a15" value="Sim" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;exitX=0.5;exitY=0;exitDx=0;exitDy=0;strokeColor=#43a047;fontColor=#2e7d32;fontSize=11;endArrow=blockThin;endFill=1" edge="1" parent="1" source="m2" target="t7">
